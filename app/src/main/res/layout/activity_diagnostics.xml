<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="20dp"
        android:paddingEnd="22dp"
        android:paddingBottom="28dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="56dp"
                android:contentDescription="뒤로가기"
                android:drawableStart="@drawable/ic_chevron_back"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="기기 진단"
                android:textColor="@color/white"
                android:textSize="27sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/deviceInfoText" style="@style/DiagnosticSection" android:layout_marginTop="20dp" android:text="기기 정보" />
        <TableLayout android:id="@+id/deviceInfoValues" style="@style/DiagnosticTable" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/adminText" style="@style/DiagnosticSection" android:layout_marginTop="20dp" android:text="기기 관리자" />
        <TableLayout android:id="@+id/adminValues" style="@style/DiagnosticTable" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/proximityText" style="@style/DiagnosticSection" android:layout_marginTop="20dp" android:text="근접 센서" />
        <TableLayout android:id="@+id/proximityValues" style="@style/DiagnosticTable" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/accelerometerText" style="@style/DiagnosticSection" android:layout_marginTop="20dp" android:text="가속도 센서" />
        <TableLayout android:id="@+id/accelerometerValues" style="@style/DiagnosticTable" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/lightText" style="@style/DiagnosticSection" android:layout_marginTop="20dp" android:text="조도 센서" />
        <TableLayout android:id="@+id/lightValues" style="@style/DiagnosticTable" android:layout_marginTop="8dp" />
        <TextView
            style="@style/DiagnosticSection"
            android:layout_marginTop="20dp"
            android:text="센서 테스트" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/lavender_card"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView
                android:id="@+id/sensorTestStatus"
                style="@style/LockStatus"
                android:text="센서 테스트: STOPPED" />
            <TextView
                android:id="@+id/sensorTestElapsed"
                style="@style/LockStatus"
                android:text="경과 시간: 00:00" />
            <Button
                android:id="@+id/sensorTestButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/lavender_button"
                android:elevation="0dp"
                android:minHeight="56dp"
                android:stateListAnimator="@null"
                android:text="센서 테스트 시작"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/resetMeasurementsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/lavender_flat_button"
                android:elevation="0dp"
                android:minHeight="52dp"
                android:stateListAnimator="@null"
                android:text="측정값 초기화"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="16sp" />
        </LinearLayout>
        <TextView
            style="@style/DiagnosticSection"
            android:layout_marginTop="20dp"
            android:text="센서 이벤트 로그" />
        <ScrollView
            android:id="@+id/eventLogScrollView"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/lavender_card"
            android:fillViewport="true"
            android:padding="12dp">
            <TextView
                android:id="@+id/eventLogText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="기록된 센서 이벤트가 없습니다."
                android:textColor="@color/ink"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />
        </ScrollView>
        <TextView
            android:id="@+id/lockTestTitle"
            style="@style/DiagnosticSection"
            android:layout_marginTop="20dp"
            android:text="화면 잠금 기능" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/lavender_card"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView
                android:id="@+id/lockTestStatus"
                style="@style/LockStatus" />
            <Button
                android:id="@+id/lockTestButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/lavender_button"
                android:elevation="0dp"
                android:minHeight="56dp"
                android:stateListAnimator="@null"
                android:text="화면 잠금 테스트"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
        <FrameLayout
            android:id="@+id/copyButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/lavender_button"
            android:clickable="true"
            android:focusable="true"
            android:padding="0dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription=""
                    android:src="@drawable/ic_copy" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:includeFontPadding="false"
                    android:text="진단 결과 복사"
                    android:textColor="@color/ink"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</ScrollView>
