<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="22dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/manualBackButton"
                android:layout_width="48dp"
                android:layout_height="56dp"
                android:clickable="true"
                android:contentDescription="뒤로가기"
                android:drawableStart="@drawable/ic_chevron_back"
                android:focusable="true"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="사용 방법"
                android:textColor="@color/white"
                android:textSize="27sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            style="@style/ManualDetails"
            android:id="@+id/manualIntro"
            android:layout_marginTop="12dp"
            android:text="처음 사용하시나요?\n\n1. 권한 허용  →  2. 감지 방식 설정  →  3. 잠금 켜기\n\nPocket Lock은 휴대폰이 주머니에 들어간 것을 감지해 화면을 자동으로 잠그는 앱입니다. 아래 순서에 따라 설정해 주세요.\n\n그림을 누르면 확대해서 확인할 수 있습니다." />

        <LinearLayout
            android:id="@+id/pocketInsertionGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">
            <ImageView
                style="@style/ManualImage"
                android:contentDescription="화면을 켠 상태로 휴대폰을 세로 방향으로 주머니에 넣는 방법"
                android:src="@drawable/manual_pocket_insertion" />
            <TextView
                android:id="@+id/pocketInsertionVideoLink"
                style="@style/ManualCaption"
                android:clickable="true"
                android:focusable="true"
                android:text="휴대폰 넣는 방법 영상 보기"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 1. 권한 -->
        <TextView
            style="@style/DiagnosticSection"
            android:id="@+id/manualPermissionHeading"
            android:layout_marginTop="22dp"
            android:text="① 화면 잠금 권한 설정" />
        <TextView
            style="@style/ManualDetails"
            android:id="@+id/manualPermissionDetails"
            android:layout_marginTop="8dp"
            android:text="• 메인 화면에서 [기기 관리자 권한 허용]을 선택합니다.\n• [이 기기 관리자 앱 활성화]를 선택합니다.\n\n※ 화면 잠금에 필요한 권한입니다." />
        <LinearLayout
            android:id="@+id/accessibilityImageColumn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <LinearLayout style="@style/ManualImageColumn">
                    <ImageView
                        style="@style/ManualImage"
                        android:contentDescription="Pocket Lock 메인 화면에서 접근성 설정을 여는 단계"
                        android:src="@drawable/manual_accessibility_01" />
                    <TextView
                        style="@style/ManualCaption"
                        android:text="① 접근성 설정 열기" />
                </LinearLayout>
                <LinearLayout style="@style/ManualImageColumn">
                    <ImageView
                        style="@style/ManualImage"
                        android:contentDescription="접근성 설정 목록에서 Pocket Lock을 선택하는 단계"
                        android:src="@drawable/manual_accessibility_02" />
                    <TextView
                        style="@style/ManualCaption"
                        android:text="② Pocket Lock 선택" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <LinearLayout style="@style/ManualImageColumn">
                    <ImageView
                        style="@style/ManualImage"
                        android:contentDescription="Pocket Lock 접근성 서비스를 켜는 단계"
                        android:src="@drawable/manual_accessibility_03" />
                    <TextView
                        style="@style/ManualCaption"
                        android:text="③ Pocket Lock 서비스 사용 설정" />
                </LinearLayout>
                <LinearLayout style="@style/ManualImageColumn">
                    <ImageView
                        style="@style/ManualImage"
                        android:contentDescription="접근성 설정 목록에서 Pocket Lock이 사용 중인지 확인하는 단계"
                        android:src="@drawable/manual_accessibility_04" />
                    <TextView
                        style="@style/ManualCaption"
                        android:text="④ 서비스 사용 여부 확인" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/legacyAdminImageRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">
            <LinearLayout style="@style/ManualImageColumn">
                <ImageView
                    style="@style/ManualImage"
                    android:contentDescription="기기 관리자 앱 활성화 화면"
                    android:src="@drawable/manual_main_off" />
                <TextView
                    style="@style/ManualCaption"
                    android:text="① 기기 관리자 권한 허용" />
            </LinearLayout>
            <LinearLayout style="@style/ManualImageColumn">
                <ImageView
                    style="@style/ManualImage"
                    android:contentDescription="기기 관리자 앱 활성화 확인 화면"
                    android:src="@drawable/manual_admin" />
                <TextView
                    style="@style/ManualCaption"
                    android:text="② [활성화] 선택" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. 켜기 -->
        <TextView
            style="@style/DiagnosticSection"
            android:layout_marginTop="22dp"
            android:text="② 감지 방식 설정" />
        <TextView
            style="@style/ManualDetails"
            android:layout_marginTop="8dp"
            android:text="• [주머니 감지 방식]에서 [내 휴대폰에 맞게 자동 설정]을 누릅니다.\n• 통화할 때처럼 휴대폰을 얼굴 가까이에 댔다가 떼는 동작을 2~3회 반복합니다.\n• [완료하기]를 눌러 설정을 마칩니다.\n\n• 근접 센서 방식: 센서가 가려지면 잠금 상태로 전환됩니다 (FAR → NEAR → FAR)\n• 복합 센서 방식: 근접 센서 반응이 불안정한 기기에서 조도·가속도·자세 센서를 함께 사용합니다." />

        <TextView
            style="@style/DiagnosticSection"
            android:layout_marginTop="22dp"
            android:text="③ 주머니 잠금 켜기" />
        <TextView
            style="@style/ManualDetails"
            android:id="@+id/manualLockOnDetails"
            android:layout_marginTop="8dp"
            android:text="• [주머니 잠금 켜기] 스위치를 켭니다.\n• 아래 문구가 표시되면 정상적으로 작동 중입니다.\n\n\'감시중 · 근접 센서로 주머니 상태를 확인합니다.\'\n또는\n\'감시중 · 조도·가속도·자세 센서로 주머니 상태를 확인합니다.\'" />
        <LinearLayout
            android:id="@+id/accessibilityLockOnImageRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:visibility="gone">
            <LinearLayout style="@style/ManualImageColumn">
                <ImageView
                    style="@style/ManualImage"
                    android:contentDescription="근접 센서 방식으로 감시 중인 화면"
                    android:src="@drawable/manual_main_on_proximity_accessibility" />
                <TextView
                    style="@style/ManualCaption"
                    android:text="근접 센서 방식" />
            </LinearLayout>
            <LinearLayout style="@style/ManualImageColumn">
                <ImageView
                    style="@style/ManualImage"
                    android:contentDescription="복합 센서 방식으로 감시 중인 화면"
                    android:src="@drawable/manual_main_on_fusion_accessibility" />
                <TextView
                    style="@style/ManualCaption"
                    android:text="복합 센서 방식" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/legacyLockOnImageRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">
            <LinearLayout style="@style/ManualImageColumn">
                <ImageView
                    style="@style/ManualImage"
                    android:contentDescription="근접 센서 방식으로 감시 중인 화면"
                    android:src="@drawable/manual_main_on_proximity_admin" />
                <TextView
                    style="@style/ManualCaption"
                    android:text="근접 센서 방식" />
            </LinearLayout>
            <LinearLayout style="@style/ManualImageColumn">
                <ImageView
                    style="@style/ManualImage"
                    android:contentDescription="복합 센서 방식으로 감시 중인 화면"
                    android:src="@drawable/manual_main_on_fusion_admin" />
                <TextView
                    style="@style/ManualCaption"
                    android:text="복합 센서 방식" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. 감지 방식 -->
        <TextView
            style="@style/DiagnosticSection"
            android:layout_marginTop="22dp"
            android:text="④ 감도는 「보통」부터" />
        <TextView
            style="@style/ManualDetails"
            android:layout_marginTop="8dp"
            android:text="• 처음에는 「보통」으로 사용하는 것을 권장합니다.\n• 주머니에 넣어도 화면이 잠기지 않으면 「민감」으로 조정합니다.\n• 의도하지 않게 잠기는 경우에는 「보통」으로 변경합니다.\n\n※ 휴대폰을 뒤집어 세로로 넣으면 감지 성능이 가장 좋습니다." />

        <!-- 잠금이 안 될 때 -->
        <TextView
            style="@style/DiagnosticSection"
            android:layout_marginTop="22dp"
            android:text="화면이 잠기지 않을 때" />
        <TextView
            style="@style/ManualDetails"
            android:layout_marginTop="8dp"
            android:text="화면이 잠기지 않는 경우 아래 순서대로 테스트한 후, 진단 결과를 개발자에게 보내 주시기 바랍니다.\n\n① [주머니 잠금 켜기]를 끕니다.\n② [기기 진단]에서 [근접 센서 테스트]를 누릅니다.\n③ 휴대폰을 세로로 주머니에 넣었다가 빼는 동작을 3회 반복합니다.\n④ [근접 센서 테스트 종료]를 누릅니다.\n⑤ 화면 아래쪽의 [진단 결과 복사]를 누릅니다.\n⑥ 메일에 결과를 붙여넣어 개발자에게 전달합니다." />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">
            <LinearLayout style="@style/ManualImageColumn">
                <ImageView
                    style="@style/ManualImage"
                    android:contentDescription="근접 센서 테스트 시작 화면"
                    android:src="@drawable/manual_diag_start" />
                <TextView
                    style="@style/ManualCaption"
                    android:text="② 테스트 시작" />
            </LinearLayout>
            <LinearLayout style="@style/ManualImageColumn">
                <ImageView
                    style="@style/ManualImage"
                    android:contentDescription="근접 센서 테스트 진행 중 화면"
                    android:src="@drawable/manual_diag_running" />
                <TextView
                    style="@style/ManualCaption"
                    android:text="③④ 주머니에 3번 넣었다 빼고 종료" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">
            <LinearLayout style="@style/ManualImageColumn">
                <ImageView
                    style="@style/ManualImage"
                    android:contentDescription="진단 결과 복사 버튼이 있는 화면"
                    android:src="@drawable/manual_diag_copy" />
                <TextView
                    style="@style/ManualCaption"
                    android:text="⑤ 맨 아래 [진단 결과 복사]" />
            </LinearLayout>
            <LinearLayout style="@style/ManualImageColumn">
                <ImageView
                    style="@style/ManualImage"
                    android:contentDescription="근접 센서 테스트 결과 불안정 화면"
                    android:src="@drawable/manual_diag_result" />
                <TextView
                    style="@style/ManualCaption"
                    android:text="결과가 \'불안정\'으로 표시되어도 해당 결과를 그대로 전달해 주시면 됩니다." />
            </LinearLayout>
        </LinearLayout>

        <!-- 5. 삭제 -->
        <TextView
            style="@style/DiagnosticSection"
            android:layout_marginTop="22dp"
            android:text="앱을 삭제하려면" />
        <TextView
            style="@style/ManualDetails"
            android:id="@+id/manualUninstallDetails"
            android:layout_marginTop="8dp"
            android:text="① [앱 삭제 준비]를 선택합니다.\n② Pocket Lock의 기기 관리자 권한을 해제합니다.\n③ 설정의 앱 목록에서 Pocket Lock을 삭제합니다.\n\n※ 권한을 해제한 뒤 앱을 삭제할 수 있습니다." />

        <TextView
            style="@style/DiagnosticSection"
            android:layout_marginTop="22dp"
            android:text="가장 간단한 순서" />
        <TextView
            style="@style/ManualDetails"
            android:layout_marginTop="8dp"
            android:text="① 권한 허용 → ② 감지 방식 자동 설정 → ③ 주머니 잠금 켜기 → ④ 주머니에 넣어 테스트" />
    </LinearLayout>
</ScrollView>
