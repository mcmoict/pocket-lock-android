<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/manualScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="18dp"
            android:paddingEnd="22dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/manualBackButton"
                    android:layout_width="40dp"
                    android:layout_height="56dp"
                    android:clickable="true"
                    android:contentDescription="메인 화면으로 돌아가기"
                    android:drawableStart="@drawable/ic_chevron_back"
                    android:focusable="true"
                    android:gravity="center" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="사용 방법"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="16dp"
            android:paddingEnd="10dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/ManualSectionHeading"
                android:text="처음이라면 이 4단계만 따라 하세요" />

            <LinearLayout
                android:id="@+id/permissionStepCard"
                style="@style/ManualGuideCard">

                <TextView
                    style="@style/ManualCardTitle"
                    android:text="① 화면 잠금 권한 허용" />

                <TextView
                    android:id="@+id/manualPermissionSummary"
                    style="@style/ManualCardBody"
                    android:text="접근성 설정에서 Pocket Lock 사용을 켜주세요." />

                <LinearLayout
                    android:id="@+id/permissionImages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/ManualImagePairItem">
                        <ImageView
                            android:id="@+id/manualPermissionImage1"
                            style="@style/ManualGuideImage"
                            android:contentDescription="접근성 메뉴에서 Pocket Lock을 선택하는 화면. 탭하여 확대할 수 있습니다."
                            android:src="@drawable/manual_accessibility_02" />
                        <TextView
                            android:id="@+id/manualPermissionCaption1"
                            style="@style/ManualCaption"
                            android:text="Pocket Lock 선택" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/ManualImagePairItem">
                        <ImageView
                            android:id="@+id/manualPermissionImage2"
                            style="@style/ManualGuideImage"
                            android:contentDescription="Pocket Lock 접근성 사용을 활성화하는 화면. 탭하여 확대할 수 있습니다."
                            android:src="@drawable/manual_accessibility_03" />
                        <TextView
                            android:id="@+id/manualPermissionCaption2"
                            style="@style/ManualCaption"
                            android:text="Pocket Lock 사용 활성화" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/detectionStepCard"
                style="@style/ManualGuideCard">

                <TextView
                    style="@style/ManualCardTitle"
                    android:text="② 감지 방식 자동 설정" />

                <TextView
                    style="@style/ManualCardBody"
                    android:text="내 휴대폰에 맞게 자동 설정 버튼을 누르고 안내에 따라 휴대폰을 움직인 후 완료 버튼을 눌러 주세요." />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lockStepCard"
                style="@style/ManualGuideCard">

                <TextView
                    style="@style/ManualCardTitle"
                    android:text="③ 주머니 잠금 켜기" />

                <TextView
                    style="@style/ManualCardBody"
                    android:text="주머니 잠금 켜기를 스위치를 활성화 해주세요." />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pocketStepCard"
                style="@style/ManualGuideCard">

                <TextView
                    style="@style/ManualCardTitle"
                    android:text="④ 주머니에 넣어보기" />

                <TextView
                    style="@style/ManualCardBody"
                    android:text="휴대폰을 세로로 주머니에 넣고 화면이 잠기는지 확인하세요." />

                <ImageView
                    style="@style/ManualGuideImage"
                    android:contentDescription="휴대폰을 거꾸로 세워 주머니에 넣는 안내 그림. 탭하여 확대할 수 있습니다."
                    android:src="@drawable/manual_pocket_insertion" />

                <TextView
                    android:id="@+id/pocketInsertionVideoLink"
                    style="@style/ManualCaption"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:text="휴대폰 넣는 방법 영상 보기"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                style="@style/ManualHelpCard">

                <TextView
                    style="@style/ManualHelpHeading"
                    android:text="도움이 필요하신가요?" />

                <TextView
                    android:id="@+id/helpLockHeader"
                    style="@style/ManualAccordionHeader"
                    android:contentDescription="화면이 잠기지 않아요, 펼쳐서 도움말 보기"
                    android:text="화면이 잠기지 않아요" />

                <LinearLayout
                    android:id="@+id/helpLockPanel"
                    style="@style/ManualAccordionPanel"
                    android:layout_marginBottom="6dp">

                    <TextView
                        style="@style/ManualCardBody"
                        android:text="다음 순서로 확인해 주세요.\n\n1. 화면 잠금 권한이 활성화되어 있는지 확인합니다.\n2. 주머니 잠금 스위치가 켜져 있는지 확인합니다.\n3. 감지 방식을 다시 자동 설정합니다.\n4. 화면이 잠기지 않으면 감도를 '민감'으로 변경해 봅니다.\n5. 문제가 계속되면 기기 진단을 실행합니다." />

                    <Button
                        android:id="@+id/helpDiagnosticsDetailsHeader"
                        style="@style/ManualNestedAccordionHeader"
                        android:contentDescription="센서 진단 결과 보내기, 펼쳐서 절차 보기"
                        android:text="센서 진단 결과 보내기" />

                    <LinearLayout
                        android:id="@+id/helpDiagnosticsDetailsPanel"
                        style="@style/ManualNestedAccordionPanel">

                        <TextView
                            style="@style/ManualCardBody"
                            android:text="1. 주머니 잠금을 잠시 끕니다.\n2. 기기 진단에서 [근접 센서 테스트]를 시작합니다.\n3. 안내에 따라 휴대폰을 얼굴 쪽으로 가져갔다가 떼는 동작을 2~3회 반복합니다.\n4. [근접 센서 테스트 종료]를 누릅니다.\n5. 진단 결과를 복사하여 개발자에게 전달합니다." />

                        <LinearLayout style="@style/ManualImagePair">
                            <LinearLayout style="@style/ManualImagePairItem">
                                <ImageView
                                    style="@style/ManualGuideImage"
                                    android:contentDescription="기기 진단의 근접 센서 테스트 시작 화면. 탭하여 확대할 수 있습니다."
                                    android:src="@drawable/manual_diag_start" />
                                <TextView
                                    style="@style/ManualCaption"
                                    android:text="근접 센서 테스트 시작" />
                            </LinearLayout>
                            <LinearLayout style="@style/ManualImagePairItem">
                                <ImageView
                                    style="@style/ManualGuideImage"
                                    android:contentDescription="근접 센서 테스트 진행 중 화면. 탭하여 확대할 수 있습니다."
                                    android:src="@drawable/manual_diag_running" />
                                <TextView
                                    style="@style/ManualCaption"
                                    android:text="안내에 따라 테스트 후 종료" />
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout style="@style/ManualImagePair">
                            <LinearLayout style="@style/ManualImagePairItem">
                                <ImageView
                                    style="@style/ManualGuideImage"
                                    android:contentDescription="진단 결과 복사 화면. 탭하여 확대할 수 있습니다."
                                    android:src="@drawable/manual_diag_copy" />
                                <TextView
                                    style="@style/ManualCaption"
                                    android:text="화면 아래쪽에서 결과 복사" />
                            </LinearLayout>
                            <LinearLayout style="@style/ManualImagePairItem">
                                <ImageView
                                    style="@style/ManualGuideImage"
                                    android:contentDescription="근접 센서 테스트 결과 화면. 탭하여 확대할 수 있습니다."
                                    android:src="@drawable/manual_diag_result" />
                                <TextView
                                    style="@style/ManualCaption"
                                    android:text="불안정 결과도 그대로 전달" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>

                        <Button
                            android:id="@+id/helpPermissionDetailsHeader"
                            style="@style/ManualNestedAccordionHeader"
                            android:contentDescription="화면 잠금 권한과 개인정보 안내, 펼쳐서 보기"
                            android:text="화면 잠금 권한과 안내 자세히 보기" />

                        <LinearLayout
                            android:id="@+id/helpPermissionDetailsPanel"
                            style="@style/ManualNestedAccordionPanel">

                            <TextView
                                android:id="@+id/manualPermissionDetails"
                                style="@style/ManualCardBody"
                                android:text="Android 9 이상에서는 권한 안내 내용을 확인하고 동의한 뒤, Android 접근성 설정에서 Pocket Lock을 직접 켜야 합니다. 동의 절차를 건너뛰거나 동의만으로 서비스가 켜지지는 않습니다.\n\nPocket Lock은 접근성 서비스를 화면 자동 잠금 실행에만 사용하며, 화면 내용이나 입력 정보 및 개인정보를 수집하거나 외부로 전송하지 않습니다. 메뉴 이름은 기기에 따라 다를 수 있습니다. Galaxy에서는 [설치된 앱], 일부 Android 기기에서는 [다운로드한 앱] 또는 [설치된 서비스]에서 찾을 수 있습니다.\n\nAndroid 8.1 이하에서는 기기 관리자 권한을 활성화합니다. 해당 방식은 Android 보안 정책에 따라 잠금 후 지문·얼굴 대신 PIN·패턴·비밀번호를 요구할 수 있습니다." />

                            <ImageView
                                android:id="@+id/manualPermissionDetailAdminImage"
                                style="@style/ManualGuideImage"
                                android:contentDescription="기기 관리자 권한 활성화 화면. 탭하여 확대할 수 있습니다."
                                android:src="@drawable/manual_admin" />
                        </LinearLayout>
                </LinearLayout>

                <View
                    style="@style/ManualHelpDivider" />

                <TextView
                    android:id="@+id/helpSensorsHeader"
                    style="@style/ManualAccordionHeader"
                    android:contentDescription="센서 방식이 궁금해요, 펼쳐서 도움말 보기"
                    android:text="센서 방식이 궁금해요" />

                <LinearLayout
                    android:id="@+id/helpSensorsPanel"
                    style="@style/ManualAccordionPanel"
                    android:layout_marginBottom="6dp">

                    <TextView
                        style="@style/ManualCardTitle"
                        android:textSize="14sp"
                        android:text="근접 센서 방식" />
                    <TextView
                        style="@style/ManualCardBody"
                        android:text="근접 센서의 상태 변화를 이용해 주머니에 들어간 상황을 감지합니다." />

                    <TextView
                        style="@style/ManualCardTitle"
                        android:layout_marginTop="14dp"
                        android:textSize="14sp"
                        android:text="복합 센서 방식" />
                    <TextView
                        style="@style/ManualCardBody"
                        android:text="근접 센서 반응이 불안정한 기기에서 조도, 가속도, 자세 정보를 함께 활용합니다." />

                    <TextView
                        android:id="@+id/manualLockStatusDetails"
                        style="@style/ManualCardBody" />

                    <Button
                        android:id="@+id/helpSensorTechnicalHeader"
                        style="@style/ManualNestedAccordionHeader"
                        android:contentDescription="센서 동작 자세히 보기, 펼쳐서 설명 보기"
                        android:text="센서 동작 자세히 보기" />

                    <LinearLayout
                        android:id="@+id/helpSensorTechnicalPanel"
                        style="@style/ManualNestedAccordionPanel">

                        <TextView
                            style="@style/ManualCardBody"
                            android:text="감지 방식 설정하기를 눌러 자동 설정을 시작하고, 통화할 때처럼 휴대폰을 얼굴 가까이 댔다가 떼는 동작을 2~3회 반복합니다. 화면의 [완료하기]를 눌러 설정을 마칩니다. 자동 설정은 근접 센서의 반응을 확인해 내 휴대폰에 맞는 감지 방식을 선택합니다.\n\n진단에서 NEAR는 센서가 가까운 물체를 감지한 상태, FAR는 가까운 물체가 없는 상태를 뜻합니다. FAR → NEAR → FAR 변화가 안정적으로 확인되지 않으면 복합 센서 방식이 선택될 수 있습니다.\n\n복합 센서 방식은 조도 변화와 가속도·자세 변화 정보를 함께 사용합니다. 휴대폰을 뒤집어 세로로 넣는 방법을 권장합니다." />

                    </LinearLayout>
                </LinearLayout>

                <View
                    style="@style/ManualHelpDivider" />

                <TextView
                    android:id="@+id/helpUninstallHeader"
                    style="@style/ManualAccordionHeader"
                    android:contentDescription="앱을 삭제하고 싶어요, 펼쳐서 도움말 보기"
                    android:text="앱을 삭제하고 싶어요" />

                <LinearLayout
                    android:id="@+id/helpUninstallPanel"
                    style="@style/ManualAccordionPanel"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/manualUninstallDetails"
                        style="@style/ManualCardBody"
                        android:text="앱 정보 화면에서 삭제할 수 있습니다." />

                </LinearLayout>

                <View
                    style="@style/ManualHelpDivider" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
