<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="22dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pocket Lock"
                android:textColor="@color/accent"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/app_version"
                android:textColor="@color/muted"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/usageGuideText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:drawableStart="@drawable/ic_info_small"
            android:drawableTint="@color/muted"
            android:drawablePadding="6dp"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="사용 안내"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="주머니 속 화면을&#10;잠그는 가장 단순한 방법"
            android:textColor="@color/white"
            android:textSize="31sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <Button
            android:id="@+id/adminButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/lavender_button"
            android:drawableStart="@android:drawable/ic_lock_lock"
            android:drawableEnd="@drawable/ic_arrow_forward"
            android:drawableTint="@color/icon_background"
            android:drawablePadding="14dp"
            android:minHeight="56dp"
            android:paddingStart="28dp"
            android:paddingEnd="18dp"
            android:text="기기 관리자 권한 허용"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/dark_panel"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp">

            <Switch
                android:id="@+id/pocketSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="0dp"
                android:text="주머니 잠금 켜기"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:thumbTint="@color/pocket_switch_thumb"
                android:trackTint="@color/pocket_switch_track"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/sensitivityGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:id="@+id/normalSensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="보통"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent" />

                <RadioButton
                    android:id="@+id/sensitiveSensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="민감"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/dark_panel"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/detectionModeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="주머니 감지 방식"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detectionModeValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="근접 센서 방식"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/detectionModeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/lavender_button"
                android:minHeight="52dp"
                android:text="판단하기"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detectionModeGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="근접 센서 테스트\n통화할 때처럼 휴대폰 화면을 얼굴 쪽으로 가져갔다가 다시 떼어주세요.\n2~3회 반복해 주세요."
                android:textColor="@color/muted"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/uninstallButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/lavender_button"
                android:drawableStart="@drawable/ic_delete_small"
                android:drawableEnd="@drawable/ic_arrow_forward_small"
                android:drawableTint="@color/icon_background"
                android:drawablePadding="6dp"
                android:minHeight="56dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="앱 삭제 준비"
                android:textAllCaps="false"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/diagnosticsButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/lavender_button"
                android:drawableStart="@drawable/ic_info_small"
                android:drawableEnd="@drawable/ic_arrow_forward_small"
                android:drawableTint="@color/icon_background"
                android:drawablePadding="6dp"
                android:minHeight="56dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="기기 진단"
                android:textAllCaps="false"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/privacyPolicyLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="4dp"
            android:text="@string/privacy_policy"
            android:textColor="@color/accent"
            android:textSize="16sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>
