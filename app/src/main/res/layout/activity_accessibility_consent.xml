<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="24dp"
    android:paddingEnd="22dp"
    android:paddingBottom="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pocket Lock 접근성 서비스 사용 안내"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TextView
            style="@style/DiagnosticDetails"
            android:text="Pocket Lock은 휴대폰이 주머니에 들어간 상태를 감지하면 화면을 자동으로 잠급니다.\n\nAndroid 9 이상에서는 화면 잠금을 실행하기 위해 Android 접근성 서비스를 사용합니다.\n\n사용 목적\n• 주머니 감지 조건이 충족된 경우 Android의 화면 잠금 기능을 실행합니다.\n\n접근 범위와 개인정보\n• 다른 앱의 화면 내용이나 텍스트를 읽지 않습니다.\n• 입력 문자, 비밀번호, 터치 동작을 읽거나 기록하지 않습니다.\n• 접근성 이벤트를 수집·저장하거나 외부로 전송하지 않습니다.\n• 화면 캡처나 제스처 기능을 요청하지 않습니다.\n• 접근성 서비스는 자동 화면 잠금 기능에만 사용합니다.\n\n동의한 뒤 Android 접근성 설정 화면에서 Pocket Lock 서비스를 직접 켜야 합니다. 동의만으로 서비스가 활성화되지는 않습니다. 생체 인식 잠금해제 지원 여부는 기기 제조사와 Android 보안 정책에 따라 달라질 수 있습니다." />
    </ScrollView>

    <Button
        android:id="@+id/accessibilityConsentAccept"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/lavender_button"
        android:minHeight="52dp"
        android:text="동의하고 설정 열기"
        android:textAllCaps="false"
        android:textColor="@color/ink"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/accessibilityConsentCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/lavender_flat_button"
        android:minHeight="48dp"
        android:text="취소"
        android:textAllCaps="false"
        android:textColor="@color/ink"
        android:textSize="16sp" />
</LinearLayout>
